{
  "manifest_version": 3,
  "name": "GG Bookmark - 书签起始页",
  "version": "1.3.1",
  "description": "现代风格的 Chrome 书签起始页：分类网格卡片、可自定义背景、书签整理器、支持导入导出配置和 WebDAV 双向智能同步。",
  "permissions": [
    "bookmarks",
    "storage",
    "tabs",
    "alarms",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/GGBookmark16.png",
    "32": "icons/GGBookmark32.png",
    "48": "icons/GGBookmark48.png",
    "128": "icons/GGBookmark128.png"
  },
  "background": {
    "service_worker": "lib/background.js"
  },
  "options_ui": {
    "page": "pages/newtab/newtab.html",
    "open_in_tab": true
  },
  "chrome_url_overrides": {
    "newtab": "pages/newtab/newtab.html"
  },
  "action": {
    "default_title": "GG Bookmark",
    "default_icon": {
      "16": "icons/GGBookmark16.png",
      "32": "icons/GGBookmark32.png",
      "48": "icons/GGBookmark48.png",
      "128": "icons/GGBookmark128.png"
    }
  }
}
